% Special characters

\renewcommand{\deg}{\ensuremath{^\circ}}

% These are the corresponding Unicode characters.
\newcommand{\textplus}{+}
\renewcommand{\textminus}{−}
\newcommand{\textdegrees}{°}
\newcommand{\textmultiplication}{×}
\newcommand{\textdivision}{÷}
\newcommand{\textplusorminus}{±}
\newcommand{\textlessthanorequal}{≤}
\newcommand{\textgreaterthanorequal}{≥}
\newcommand{\textinfinity}{∞}

\newcommand{\plus}[1]{\textplus#1}
\newcommand{\plusafter}[1]{#1\textplus}
\newcommand{\binaryplus}[2]{\mbox{#1\space\textplus\space#2}}

\newcommand{\minus}[1]{\textminus#1}
\newcommand{\minusafter}[1]{#1\textminus}
\newcommand{\binaryminus}[2]{\mbox{#1\space\textminus\space#2}}

\newcommand{\binaryplusorminus}[2]{#1~\textplusorminus~#2}

\newcommand{\multiplybefore}[1]{\textmultiplication#1}
\newcommand{\multiplyafter}[1]{#1\textmultiplication}
\newcommand{\binarymultiply}[2]{\mbox{#1\space\textmultiplication\space#2}}

\newcommand{\binarydivide}[2]{\mbox{#1\space\textdivision#2}}

\newcommand{\lessthanbefore}[1]{<#1}
\newcommand{\lessthanorequaltobefore}[1]{\textlessthanorequal#1}
\newcommand{\greaterthanbefore}[1]{>#1}
\newcommand{\greaterthanorequaltobefore}[1]{\textgreaterthanorequal#1}

\newcommand{\binaryrelation}[3]{#1~#2~#3}
\newcommand{\triperelation}[5]{#1~#2~#3~#4~#5}

\newcommand{\degrees}[1]{#1\textdegrees}

\newcommand{\arc}[1]{\degrees{#1}}
\newcommand{\arcline}[1]{\degrees{#1}}
\newcommand{\arcplus}[1]{\plusafter{\degrees{#1}}}
\newcommand{\arcminus}[1]{\minusafter{\degrees{#1}}}
\newcommand{\arcborder}[2]{\degrees{#1}/\degrees{#2}}

