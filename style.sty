% Notes

\usepackage{enotez}

\newcommand{\listofnotesheading}[1]{%
    \twocolumn[
        \section{#1}
    ]
}

\setenotez{%
    list-heading={\listofnotesheading{#1}},
    reset = true,
    backref = true
}

\newcommand{\note}[2]{%
    \endnote{%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{\smallskipamount}%
        \noteparagraph{#1} #2
    }%
}

\newcommand{\noteparagraph}[1]{%
    {\bfseries #1.} \ignorespaces%
}

\newcommand{\listofnotes}{
    \printendnotes[itemize]
}

