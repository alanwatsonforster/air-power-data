%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% TABLE OF CONTENTS

\usepackage[titles]{tocloft}

\setcounter{tocdepth}{1}

% Reduce the vertical space in the TOC.

\setlength{\cftbeforechapskip}{0em}
\setlength{\cftbeforesecskip}{0em}

% Typeset the titles, leaders, and page number in normalfont. Use \small for
% chapters and \footnotesize for sections and subsection.

\renewcommand{\cftchapfont}{\normalfont\small}
\renewcommand{\cftsecfont}{\normalfont\footnotesize}
\renewcommand{\cftsubsecfont}{\normalfont\footnotesize}

\renewcommand{\cftchapleader}{\normalfont\cftdotfill{\cftchapdotsep}}
\renewcommand{\cftsecleader}{\normalfont\cftdotfill{\cftsecdotsep}}
\renewcommand{\cftsubsecleader}{\normalfont\cftdotfill{\cftsecdotsep}}

\renewcommand{\cftchappagefont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}
\renewcommand{\cftsubsecpagefont}{\normalfont}

% Use leaders for chapters, sections, and subsection.

\renewcommand{\cftchapdotsep}{\cftdotsep}
\renewcommand{\cftsecdotsep}{\cftdotsep}
\renewcommand{\cftsubsecdotsep}{\cftdotsep}

% Reduce the spacing between dots in the leaders.

\renewcommand{\cftdotsep}{1}

% By default, in the report style the TOC is set as a chapter, with a clearpage,
% and as wide as \textwidth. I want it to be set as a section, without the
% clearpage, and as wide as \linewidth (so that it works when set in two
% columns).

\makeatletter

\let\original@tableofcontents\tableofcontents
\renewcommand{\tableofcontents}{
    %
    \let\saved@clearpage\clearpage
    \let\saved@textwidth\textwidth
    \@ifundefined{chapter}{}{\let\saved@chapter\chapter}
    %
    \let\clearpage\relax
    \let\textwidth\linewidth
    \@ifundefined{chapter}{}{\let\chapter\section}
    %
    \original@tableofcontents
    %
    \let\clearpage\saved@clearpage
    \let\textwidth\saved@textwidth
    \@ifundefined{chapter}{}{\let\chapter\saved@chapter}
}

\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% RULES SECTIONS

% Rule sections are built upon normal section.

\makeatletter

\newcounter{rulesection}
\newcommand{\rulesection}[1]{%
    \stepcounter{rulesection}
    \section{Rule \arabic{rulesection}: #1}
}

\newcounter{rulesubsection}[rulesection]
\newcommand{\rulesubsection}[1]{%
    \stepcounter{rulesubsection}
    \subsection{\Alph{rulesubsection}. #1}
}

% Examples: in 40.B and 40.C.
\newcounter{rulesubsubsection}[rulesubsection]
\newcommand{\rulesubsubsection}[1]{%
    \stepcounter{rulesubsubsection}
    \subsubsection{\arabic{rulesubsubsection}. #1}
}

\newcommand{\ruleparagraph}[1]{
    \paragraph{#1}
}

\newcommand{\advancedrule}{
    \@startsection{section}{1}%
    {0pt}%
    {1.0ex plus 0.3ex minus 0.1ex}%
    {0.1ex plus 0.1ex minus 0.1ex}%
    {\normalfont\normalsize\bfseries\raggedright}%
    *{Advanced Rule}
}

\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% SUBSECTIONS WITH COUNTERS

% The aim here is to have a counter image at the left margin and a subsection
% describing the counter wrapped around it.

\usepackage{hanging}
\usepackage{needspace}

\makeatletter

\newcommand{\vspacelines}[1]{\vspace{#1\baselineskip}}

\newcommand{\@subsectionwithcounters}[3]{%
    \Needspace{#1\baselineskip}%
    \hangpara{5em}{-#1}%
    \makebox[0em][r]{#3\hspace{0.5em}}%
    {\bfseries #2:}
    \addcontentsline{toc}{subsection}{#2}%
    \ignorespaces\@ifnextchar\par{\@gobble}{}
}

\newcommand{\subsectionwithcounter}[2]{%
    \@subsectionwithcounters{4}{#1}{%
        \makebox[0em][r]{\raisebox{-3.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#2.png}}}%
    }
}

\newcommand{\subsectionwithtwocounters}[3]{%
    \@subsectionwithcounters{8}{#1}{%
        \makebox[0em][r]{\raisebox{-3.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#2.png}}}%
        \makebox[0em][r]{\raisebox{-8.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#3.png}}}%
    }
}

\newcommand{\subsectionwiththreecounters}[4]{%
    \@subsectionwithcounters{12}{#1}{%
        \makebox[0em][r]{\raisebox{-3.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#2.png}}}%
        \makebox[0em][r]{\raisebox{-8.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#3.png}}}%
        \makebox[0em][r]{\raisebox{-13.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#4.png}}}%
    }
}

\newcommand{\subsectionwithfourcounters}[5]{%
    \@subsectionwithcounters{16}{#1}{%
        \makebox[0em][r]{\raisebox{-3.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#2.png}}}%
        \makebox[0em][r]{\raisebox{-8.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#3.png}}}%
        \makebox[0em][r]{\raisebox{-13.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#4.png}}}%
        \makebox[0em][r]{\raisebox{-18.8em}[0em][0em]{\includegraphics[width=4.5em]{counters/#5.png}}}%
    }
}

\newcommand{\subsectionwithcountercontinued}[2]{%
    \@subsectionwithcounters{#1}{#2}{\hfill}
}

\makeatother

