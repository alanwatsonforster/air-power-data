% Lists

\usepackage{enumitem}

\setlist[itemize]{
    noitemsep,
    nolistsep,
    leftmargin=0em,
    labelindent=\parindent,
    labelwidth=*,
    labelsep=\interwordspace,
    itemindent=*,
    label=--,
}
\setlist[enumerate]{
    noitemsep,
    nolistsep,
    leftmargin=0em,
    labelindent=\parindent,
    labelwidth=*,
    labelsep=\interwordspace,
    itemindent=*,
    align=left
}
\setlist[enumerate,2]{
    label=\alph*.
}

\setlist[itemize,2]{
    leftmargin=2em
}

\newcommand{\itemparagraph}[1]{{\bfseries #1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% END NOTES

\usepackage{enotez}

\newcommand{\listofnotesheading}[1]{%
    \chapter{#1}
}

\setenotez{%
    list-heading={\listofnotesheading{#1}},
    reset = true,
    backref = true
}

\newcommand{\note}[2]{%
    \endnote{%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{\smallskipamount}%
        {\bfseries #1}\par\nopagebreak #2
    }%
}

\newcommand{\noteparagraph}[1]{%
    \par{\itshape #1:} \ignorespaces%
}

\newenvironment{notesources}{%
    \noteparagraph{Sources}
    \begin{itemize}\raggedright
        }{
    \end{itemize}
}

\newcommand{\listofnotes}{
    \printendnotes[itemize]
}

