\newlength{\digitwidth}
\settowidth{\digitwidth}{0}
\newcommand{\aligninteger}[2]{\makebox[#1\digitwidth][r]{#2}}

\newlength{\wboxwidth}
\newcommand{\wbox}[3][r]{%
    \settowidth{\wboxwidth}{#2}%
    \makebox[\wboxwidth][#1]{#3}%
}

