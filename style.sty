}}

\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% CHAPTERS AND SECTIONS

% No numbering by default.

\setcounter{secnumdepth}{0}

\makeatletter

% Chapter headings start a new page, as full width, broken-out, flush left,
% ragged right, \Large, bold, and uppercase. Chapters are never numbered.
% Chapters are not handled by \@startsection, so we have to redefine them
% manually.

\newcommand{\chapter@star}[1]{%
    \stepcounter{chapter}%
    \clearpage%
    \twocolumn[%
        \vspace*{1.5ex}%
        \normalfont{\Large\bfseries\raggedright\MakeUppercase{#1}}\par
        \vspace{2.0ex}%
    ]%
}
\newcommand{\chapter@nostar}[1]{%
    \chapter@star{#1}%
    \addcontentsline{toc}{chapter}{\MakeUppercase{#1}}%
}
\renewcommand{\chapter}{\@ifstar{\chapter@star}{\chapter@nostar}}

% Section headings are broken-out, flush left, ragged right, \normalsize, bold,
% and uppercase.

\newcommand{\section@handler}{%
    \@startsection{section}{1}%
    {0pt}%
    {2.0ex plus 0.6ex minus 0.2ex}%
    {1.0ex plus 0.3ex minus 0.1ex}%
    {\normalfont\normalsize\bfseries\raggedright}%
}
\newcommand{\section@star}[1]{%
    \section@handler*{\MakeUppercase{#1}}%
}
\newcommand{\section@nostar}[1]{%
    \section@handler{\MakeUppercase{#1}}%
}
\renewcommand{\section}{\@ifstar{\section@star}{\section@nostar}}

% Subsections headings are run-in, indented, normalsize, bold, with a trailing
% colon.

\renewcommand{\subsection}{%
    \@startsection{subsection}{2}%
    {\parindent}%
    {0pt}%
    {-\interwordspace}%
    {\normalfont\normalsize\bfseries\@addcolon}%
}
\newcommand{\@addcolon}[1]{#1:}
\newlength{\interwordspace}
\setlength{\interwordspace}{
    \fontdimen2\font plus \fontdimen3\font minus \fontdimen4\font
}

% Paragraph headings are run-in, indented, normalsize, italic, with a trailing
% colon.

\renewcommand\paragraph{%
    \@startsection{paragraph}{4}%
    {\parindent}%
    {0pt}%
    {-\interwordspace}%
    {\normalfont\normalsize\itshape\@addcolon}%
}

\makeatother

% Example paragraphs.

\newcommand{\example}[2][Example]{{\itshape #1:} #2}
\newcommand{\examples}[1]{\example[Examples]{#1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% TABLE OF CONTENTS

\usepackage[titles]{tocloft}

\setcounter{tocdepth}{1}

% Reduce the vertical space in the TOC.

\setlength{\cftbeforechapskip}{0em}
\setlength{\cftbeforesecskip}{0em}

% Typeset the titles, leaders, and page number in normalfont. Use \small for
% chapters and \footnotesize for sections and subsection.

\renewcommand{\cftchapfont}{\normalfont\small}
\renewcommand{\cftsecfont}{\normalfont\footnotesize}
\renewcommand{\cftsubsecfont}{\normalfont\footnotesize}

\renewcommand{\cftchapleader}{\normalfont\cftdotfill{\cftchapdotsep}}
\renewcommand{\cftsecleader}{\normalfont\cftdotfill{\cftsecdotsep}}
\renewcommand{\cftsubsecleader}{\normalfont\cftdotfill{\cftsecdotsep}}

\renewcommand{\cftchappagefont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}
\renewcommand{\cftsubsecpagefont}{\normalfont}

% Use leaders for chapters, sections, and subsection.

\renewcommand{\cftchapdotsep}{\cftdotsep}
\renewcommand{\cftsecdotsep}{\cftdotsep}
\renewcommand{\cftsubsecdotsep}{\cftdotsep}

% Reduce the spacing between dots in the leaders.

\renewcommand{\cftdotsep}{1}

% By default, in the report style the TOC is set as a chapter, with a clearpage,
% and as wide as \textwidth. I want it to be set as a section, without the
% clearpage, and as wide as \linewidth (so that it works when set in two
% columns).

\makeatletter

\let\original@tableofcontents\tableofcontents
\renewcommand{\tableofcontents}{
    %
    \let\saved@clearpage\clearpage
    \let\saved@textwidth\textwidth
    \@ifundefined{chapter}{}{\let\saved@chapter\chapter}
    %
    \let\clearpage\relax
    \let\textwidth\linewidth
    \@ifundefined{chapter}{}{\let\chapter\section}
    %
    \original@tableofcontents
    %
    \let\clearpage\saved@clearpage
    \let\textwidth\saved@textwidth
    \@ifundefined{chapter}{}{\let\chapter\saved@chapter}
}

\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% RULES SECTIONS

% Rule sections are built upon normal section.

\makeatletter

\newcounter{rulesection}
\newcommand{\rulesection}[1]{%
    \stepcounter{rulesection}
    \section{Rule \arabic{rulesection}: #1}
}

\newcounter{rulesubsection}[rulesection]
\newcommand{\rulesubsection}[1]{%
    \stepcounter{rulesubsection}
    \subsection{\Alph{rulesubsection}. #1}
}

% Examples: in 40.B and 40.C.
\newcounter{rulesubsubsection}[rulesubsection]
\newcommand{\rulesubsubsection}[1]{%
    \stepcounter{rulesubsubsection}
    \subsubsection{\arabic{rulesubsubsection}. #1}
}

\newcommand{\ruleparagraph}[1]{
    \paragraph{#1}
}

\newcommand{\advancedrule}{
    \@startsection{section}{1}%
    {0pt}%
    {1.0ex plus 0.3ex minus 0.1ex}%
    {0.1ex plus 0.1ex minus 0.1ex}%
    {\normalfont\normalsize\bfseries\raggedright}%
    *{Advanced Rule}
}

\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% SUBSECTIONS WITH COUNTERS

% The aim here is to have a counter image at the left margin and a subsection
% describing the counter wrapped around it. I've not quite managed this, so
% instead I am settling for a counter in a column at the left and a subsection
% describing it in a column on the right. This means the text does not wrap and
% will not break. However, it's not too bad.

% I originally tried to get this to work with the wrapfig2 package, but I had
% problems with columns breaking unexpectedly.

% These stack one to four counters vertically.

\newcommand{\counter}[1]{%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#1.png}}}\par%
}
\newcommand{\twocounters}[2]{%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#1.png}}}\par%
    \vspace{0.15em}%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#2.png}}}%
}
\newcommand{\threecounters}[3]{%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#1.png}}}\par%
    \vspace{0.15em}%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#2.png}}}\par%
    \vspace{0.15em}%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#3.png}}}%
}
\newcommand{\fourcounters}[4]{%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#1.png}}}\par%
    \vspace{0.15em}%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#2.png}}}\par%
    \vspace{0.15em}%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#3.png}}}\par%
    \vspace{0.15em}%
    \raisebox{-3.2em}{{\includegraphics[width=4em]{counters/#4.png}}}%
}

\makeatletter

% Use this as:
%
% \subsectionwithcounter{SUBSECTION HEADING}{COUNTER}{TEXT}

\newlength{\@textwidthwithcounter}
\newcommand{\subsectionwithcounter}[3]{%
    \vspace{0.13em}
    \noindent
    \setlength{\@textwidthwithcounter}{\linewidth}%
    \addtolength{\@textwidthwithcounter}{-4em}%
    \addtolength{\@textwidthwithcounter}{-\tabcolsep}%
    % I do not understand why I need to subtract an extra 2.7pt, but if I do not I get an overfull hbox warning.
    \addtolength{\@textwidthwithcounter}{-2.7pt}%
    \begin{tabular}{@{}p{4em}p{\@textwidthwithcounter}@{}}
        #2&%
        % If I use \subsection{#1}, I get additional space above the heading. I don't know why. The simplest fix seems to be to explicitly format the heading.
        {\bfseries #1:}%
        \addcontentsline{toc}{subsection}{#1}%
        #3\\
    \end{tabular}\par
}

\makeatother

