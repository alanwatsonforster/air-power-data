% Lists

\usepackage{enumitem}

\setlist[itemize]{
    noitemsep,
    nolistsep,
    leftmargin=0em,
    labelindent=\parindent,
    labelwidth=*,
    labelsep=\interwordspace,
    itemindent=*,
    label=--,
}
\setlist[enumerate]{
    noitemsep,
    nolistsep,
    leftmargin=0em,
    labelindent=\parindent,
    labelwidth=*,
    labelsep=\interwordspace,
    itemindent=*,
    align=left
}
\setlist[enumerate,2]{
    label=\alph*.
}

\newcommand{\itemparagraph}[1]{{\bfseries #1}}

