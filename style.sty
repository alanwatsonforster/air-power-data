% Sections

\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{1}

\newlength{\interwordspace}
\setlength{\interwordspace}{\fontdimen2\font plus \fontdimen3\font
minus \fontdimen4\font}

\makeatletter

% The vertical spaces are multiples of \parskip

\renewcommand
\section{%
    % broken-out, flush left, ragged right, normalsize, bold, uppercase
    \@startsection{section}{1}%
    {0pt}%
    {2.0ex plus 0.6ex minus 0.2ex}%
    {1.0ex plus 0.3ex minus 0.1ex}%
    {\normalfont\normalsize\bfseries\raggedright\MakeUppercase}%
}

\renewcommand
\subsection{%
    % run-in, indented, normalsize, bold, with trailing colon.
    \@startsection{subsection}{2}%
    {\parindent}%
    {0pt}%
    {-\interwordspace}%
    {\normalfont\normalsize\bfseries\addcolon}%
}

\renewcommand\paragraph{%
    % run-in, indented, normalsize, italic, with trailing colon.
    \@startsection{paragraph}{4}%
    {\parindent}%
    {0pt}%
    {-\interwordspace}%
    {\normalfont\normalsize\itshape\addcolon}%
}

\newcommand{\addcolon}[1]{#1:}
\newcommand{\addperiod}[1]{#1.}

\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter

\newcounter{rulesection}
\newcommand{\rulesection}[1]{%
    \stepcounter{rulesection}
    \section{Rule \arabic{rulesection}: #1}
}

\newcounter{rulesubsection}[rulesection]
\newcommand{\rulesubsection}[1]{%
    \stepcounter{rulesubsection}
    \subsection{\Alph{rulesubsection}. #1}
}

% Examples: in 40.B and 40.C.
\newcounter{rulesubsubsection}[rulesubsection]
\newcommand{\rulesubsubsection}[1]{%
    \stepcounter{rulesubsubsection}
    \subsubsection{\arabic{rulesubsubsection}. #1}
}

\newcommand{\ruleparagraph}[1]{
    \paragraph{#1}
}

\newcommand{\advancedrule}{
    \@startsection{section}{1}%
    {0pt}%
    {1.0ex plus 0.3ex minus 0.1ex}%
    {0.1ex plus 0.1ex minus 0.1ex}%
    {\normalfont\normalsize\bfseries\raggedright}%
    *{Advanced Rule}
}

\makeatother

