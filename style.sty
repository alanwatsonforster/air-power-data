% Sections

\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{1}

\newlength{\interwordspace}
\setlength{\interwordspace}{\fontdimen2\font plus \fontdimen3\font
minus \fontdimen4\font}

\makeatletter

% The vertical spaces are multiples of \parskip

\renewcommand
\section{%
    \@startsection{section}{1}%
    {0pt}%
    {-2.1ex plus -0.6ex minus -0.3ex}%
    {2.1ex plus 0.6ex minus 0.3ex}%
    {\normalfont\Large\bfseries\raggedright}%
}

\renewcommand
\subsection{%
    \@startsection{subsection}{2}%
    {0pt}%
    {-1.4ex plus -0.4ex minus -0.2ex}%
    {1.4ex plus 0.4ex minus-0.2ex}%
    {\normalfont\large\bfseries\raggedright}%
}

\renewcommand
\subsubsection{%
    \@startsection{subsubsection}{3}%
    {0pt}%
    {-0.7ex plus -0.2ex minus -0.1ex}%
    {1.4ex plus 0.4ex minus-0.2ex}%
    {\normalfont\bfseries\raggedright}%
}

\renewcommand\paragraph{%
    \@startsection{paragraph}{4}%
    {0pt}%
    {-0.7ex plus -0.2ex minus -0.1ex}%
    {-\interwordspace}%
    {\normalfont\normalsize\bfseries\addperiod}%
}

\newcommand{\addperiod}[1]{#1.}

\makeatother

