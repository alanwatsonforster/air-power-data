% Lists

\usepackage{enumitem}

\setlist[itemize]{
    align=left,
    labelwidth=1.2em,
    labelsep=0.3em,
    leftmargin=1.5em,
    nosep,
    parsep=\parskip,
    label=--,
}
\setlist[enumerate]{
    align=left,
    leftmargin=1.5em,
    labelwidth=1.2em,
    labelsep=0.3em,
    parsep=\parskip,
}
\setlist[enumerate,2]{
    label=\alph*.
}

\newcommand{\itemparagraph}[1]{{\bfseries #1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Text Notes

% These commands allow the optional creation of footnotes. To include footnotes,
% use \textnotestrue in the preamble after including this file. To omit them,
% use \textnotesfalse.

\newif\iftextnotes

% Create a text note. The first argument it the title of the note and the second
% is the text.
\newcommand{\textnote}[2]{%
    \iftextnotes%
    \footnote{%
        \setlength{\parindent}{0pt}%
        \setlength{\parskip}{\smallskipamount}%
        ~{\bfseries #1.} \ignorespaces #2%
    }%
    \fi%
}

% Create a section within a text note. The argument is the title of the section.
\newcommand{\textnotesection}[1]{%
    {\itshape\bfseries #1.} \ignorespaces
}

% Clear all text notes. Use this, for example, at the end of a chapter or
% section of text.
\newcommand{\cleartextnotes}{%
    \iftextnotes%
    \clearpage%
    \fi%
}

% Add some space between footnotes.
\setlength{\footnotesep}{11pt}

% Don't break footnotes between columns so easily.
\interfootnotelinepenalty=1000

